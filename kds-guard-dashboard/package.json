{
  "name": "kds-guard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "description": "KDS Guard — BadUSB Detection via Keystroke Dynamics",
  "author": "KDS Guard Project 2026",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "predeploy": "vite build && powershell -Command \"Copy-Item ./dist/index.html -Destination ./dist/404.html\"",
    "deploy": "gh-pages -d dist",
    "electron:dev": "vite",
    "electron:build": "vite build && electron-builder --win --config electron-builder.json --publish never",
    "electron:build:dir": "vite build && electron-builder --win --dir --config electron-builder.json --publish never",
    "electron:preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^5.15.19",
    "@mui/material": "^5.15.19",
    "@mui/x-data-grid": "^7.6.2",
    "echarts": "^5.5.0",
    "echarts-for-react": "^3.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.23.1",
    "simplebar-react": "^3.2.6",
    "swiper": "^11.1.4"
  },
  "devDependencies": {
    "@iconify/react": "^5.0.1",
    "@types/node": "^20.14.9",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vite-tsconfig-paths": "^4.3.2"
  }
}
