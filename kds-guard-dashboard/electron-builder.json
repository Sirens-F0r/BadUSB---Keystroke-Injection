{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.kdsguard.app",
  "productName": "KDS Guard",
  "copyright": "Copyright 2026 — KDS Guard Project",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json",
    "ws_bridge.py",
    "public/**/*"
  ],
  "asar": true,
  "extraResources": [
    {
      "from": "../kds_guard/target/release/kds_guard.exe",
      "to": "kds_guard.exe"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": "x64"
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "KDS Guard"
  }
}
